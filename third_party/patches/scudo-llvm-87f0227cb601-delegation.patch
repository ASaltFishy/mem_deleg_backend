+            print(f"图表: {results_dir / f'{prefix}{metric}_latency_small_sizes.png'}")
+            print(f"图表: {results_dir / f'{prefix}{metric}_speedup_heatmap.png'}")
+            print(f"图表: {results_dir / f'{prefix}{metric}_speedup_lines.png'}")
+    print(f"摘要: {output_md}")
