+template <typename Config> static Options getOptionsForConfig() {
+  if (!Config::getMaySupportMemoryTagging() ||
+      !archSupportsMemoryTagging() || !systemSupportsMemoryTagging())
+    return {};
+  AtomicOptions AO;
+  AO.set(OptionBit::UseMemoryTagging);
+  return AO.load();
+}
+
+using BenchConfig = scudo::Config;
+using LargeAllocator = MapAllocator<SecondaryConfig<BenchConfig>>;
+using CombinedAllocator = Allocator<BenchConfig>;
+static constexpr uptr PrimaryMaxSize =
+    BenchConfig::Primary::SizeClassMap::MaxSize;
+static bool PassiveTraditional = false;
+
+static void selectBenchPath(bool Delegated) {
+  if (Delegated)
+    setSharedArenaForceForTesting(true);
+  else if (PassiveTraditional)
+    clearSharedArenaForceForTesting();
+  else
+    setSharedArenaForceForTesting(false);
+}
+
+static uint64_t nowNs() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+static u64 getEnvU64(const char *Name, u64 Default) {
+  const char *Value = getenv(Name);
+  if (!Value || Value[0] == '\0')
+    return Default;
+  char *End = nullptr;
+  errno = 0;
+  const unsigned long long Parsed = strtoull(Value, &End, 0);
+  if (errno != 0 || End == Value)
+    return Default;
+  return static_cast<u64>(Parsed);
+}
+
+static bool shouldTraceBenchPhase(uptr Size, u64 Iter) {
+  if (getEnvU64("SCUDO_BENCH_TRACE_PHASE", 0) == 0)
+    return false;
+  const uptr MinSize = static_cast<uptr>(
+      getEnvU64("SCUDO_BENCH_TRACE_MIN_SIZE", 8ULL << 20));
+  const u64 Every = getEnvU64("SCUDO_BENCH_TRACE_EVERY", 0);
+  if (Every == 0 || Size < MinSize)
+    return false;
+  return (Iter % Every) == 0;
+}
+
+static void printProcMeminfo(const char *Label) {
+#if SCUDO_LINUX
+  FILE *F = fopen("/proc/meminfo", "r");
+  if (!F) {
+    printf("proc_meminfo: label=%s open_failed_errno=%d\n", Label, errno);
+    return;
+  }
+  char Line[256];
+  printf("proc_meminfo: label=%s", Label);
+  while (fgets(Line, sizeof(Line), F)) {
+    unsigned long Value = 0;
+    if (sscanf(Line, "MemTotal: %lu kB", &Value) == 1 ||
+        sscanf(Line, "MemFree: %lu kB", &Value) == 1 ||
+        sscanf(Line, "MemAvailable: %lu kB", &Value) == 1 ||
+        sscanf(Line, "Cached: %lu kB", &Value) == 1 ||
+        sscanf(Line, "SReclaimable: %lu kB", &Value) == 1 ||
+        sscanf(Line, "SUnreclaim: %lu kB", &Value) == 1) {
+      char *Colon = strchr(Line, ':');
+      if (!Colon)
+        continue;
+      *Colon = '\0';
+      printf(" %s=%lu_kB", Line, Value);
+    }
+  }
+  fclose(F);
+  printf("\n");
+  fflush(stdout);
+#else
+  (void)Label;
+#endif
+}
+
+static void printBenchPhase(const char *PathLabel, bool Delegated, uptr Size,
+                            bool WarmupPhase, u64 Iter, const char *Phase,
+                            void *Ptr) {
+#if SCUDO_LINUX
+  if (!shouldTraceBenchPhase(Size, Iter))
+    return;
+  const int Cpu = sched_getcpu();
+  printf("bench_phase: path=%s delegated=%d size=%zu phase=%s kind=%s iter=%"
+         PRIu64 " pid=%d tid=%lu cpu=%d ptr=%p ns=%" PRIu64 "\n",
+         PathLabel, Delegated ? 1 : 0, static_cast<size_t>(Size), Phase,
+         WarmupPhase ? "warmup" : "measure", Iter, getpid(),
+         static_cast<unsigned long>(pthread_self()), Cpu, Ptr, nowNs());
+  fflush(stdout);
+#else
+  (void)PathLabel;
+  (void)Delegated;
+  (void)Size;
+  (void)WarmupPhase;
+  (void)Iter;
+  (void)Phase;
+  (void)Ptr;
+#endif
+}
+
+static bool pinSelfToCpu(int Cpu) {
+#if SCUDO_LINUX
+  cpu_set_t Set;
+  CPU_ZERO(&Set);
+  CPU_SET(Cpu, &Set);
+  // Use thread-level affinity so process-level affinity (used by
+  // SharedArenaPool::getNumberOfCPUs via sched_getaffinity) stays stable.
+#if SCUDO_ANDROID
+  // Android bionic does not expose pthread_setaffinity_np consistently across
+  // API levels/toolchains; sched_setaffinity(0, ...) still pins the calling
+  // thread on Linux/Android.
+  return sched_setaffinity(0, sizeof(Set), &Set) == 0;
+#else
+  return pthread_setaffinity_np(pthread_self(), sizeof(Set), &Set) == 0;
+#endif
+#else
+  (void)Cpu;
+  return false;
+#endif
+}
+
+static void printAffinity(const char *Label) {
+#if SCUDO_LINUX
+  cpu_set_t Set;
+  CPU_ZERO(&Set);
+  if (sched_getaffinity(0, sizeof(Set), &Set) != 0) {
+    printf("%s affinity: <sched_getaffinity failed errno=%d>\n", Label, errno);
+    return;
+  }
+  printf("%s affinity:", Label);
+  const int Max = CPU_SETSIZE < 1024 ? CPU_SETSIZE : 1024;
+  for (int C = 0; C < Max; ++C) {
+    if (CPU_ISSET(C, &Set))
+      printf(" %d", C);
+  }
+  printf("\n");
+#else
+  printf("%s affinity: N/A (non-Linux)\n", Label);
+#endif
+}
