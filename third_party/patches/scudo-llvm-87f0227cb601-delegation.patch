+    size_arg = ",".join(str(x) for x in size_bytes)
+    touch_page_modes = [int(x) for x in parse_list(args.touch_page_modes)]
+    extra_bench_args = shlex.split(args.bench_extra_args) if args.bench_extra_args else []
