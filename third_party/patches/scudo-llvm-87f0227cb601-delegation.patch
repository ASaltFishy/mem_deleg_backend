+static int firstUsableArenaCpu(SharedArenaPool &Pool) {
+#if SCUDO_LINUX
+  if (!Pool.isReady() || Pool.getNumCores() == 0)
+    return -1;
+  cpu_set_t Allowed;
+  CPU_ZERO(&Allowed);
+  if (sched_getaffinity(0, sizeof(Allowed), &Allowed) != 0)
+    return -1;
+  for (u32 Cpu = 0; Cpu < Pool.getNumCores(); ++Cpu) {
+    if (CPU_ISSET(static_cast<int>(Cpu), &Allowed))
+      return static_cast<int>(Cpu);
+  }
+#endif
+  return -1;
+}
+
+static u32 allowedCpuCount() {
+#if SCUDO_LINUX
+  cpu_set_t Allowed;
+  CPU_ZERO(&Allowed);
+  if (sched_getaffinity(0, sizeof(Allowed), &Allowed) != 0)
+    return 1;
+  u32 Count = 0;
+  const int Max = CPU_SETSIZE < 1024 ? CPU_SETSIZE : 1024;
+  for (int Cpu = 0; Cpu < Max; ++Cpu) {
+    if (CPU_ISSET(Cpu, &Allowed))
+      Count++;
+  }
+  return Count ? Count : 1;
+#else
+  return 1;
+#endif
+}
+
+static int firstAllowedCpu() {
+#if SCUDO_LINUX
+  cpu_set_t Allowed;
+  CPU_ZERO(&Allowed);
+  if (sched_getaffinity(0, sizeof(Allowed), &Allowed) == 0) {
+    const int Max = CPU_SETSIZE < 1024 ? CPU_SETSIZE : 1024;
+    for (int Cpu = 0; Cpu < Max; ++Cpu) {
+      if (CPU_ISSET(Cpu, &Allowed))
+        return Cpu;
+    }
+  }
+#endif
+  return 0;
+}
