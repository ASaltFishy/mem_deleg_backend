+def write_metric_tables(f, summary_df, metric):
+    metric_df = summary_df[summary_df["metric"] == metric].copy()
+    if "bench_mode" in metric_df.columns:
+        modes = sorted(metric_df["bench_mode"].unique())
+        if len(modes) > 1:
+            f.write(f"## {metric_label(metric)} mean latency\n\n")
+            for mode in modes:
+                f.write(f"### mode={mode}\n\n")
+                write_metric_tables(
+                    f, metric_df[metric_df["bench_mode"] == mode], metric
+                )
+            return
+    touch_modes = (
+        sorted(metric_df["touch_pages"].unique())
+        if "touch_pages" in metric_df.columns
+        else [1]
+    )
+    if len(touch_modes) > 1:
+        f.write(f"## {metric_label(metric)} mean latency\n\n")
+        for touch_pages in touch_modes:
+            f.write(f"### touch_pages={touch_pages}\n\n")
+            write_metric_tables(
+                f, metric_df[metric_df["touch_pages"] == touch_pages], metric
+            )
+        return
+
+    delegated = metric_df[metric_df["path"] == "delegated"].copy()
+    traditional = metric_df[metric_df["path"] == "traditional"].copy()
+    merge_cols = ["threads", "size_human", "size_bytes", "metric"]
+    if "bench_mode" in metric_df.columns:
+        merge_cols.insert(0, "bench_mode")
+    if "touch_pages" in metric_df.columns:
+        merge_cols.insert(1, "touch_pages")
+    speedup_df = delegated.merge(
+        traditional,
+        on=merge_cols,
+        suffixes=("_delegated", "_traditional"),
+    )
+    speedup_df["speedup"] = (
+        speedup_df["mean_ns_traditional"] / speedup_df["mean_ns_delegated"]
+    )
+
+    f.write(f"## {metric_label(metric)} mean latency\n\n")
+    pivot = metric_df.pivot_table(
+        index=(["bench_mode", "path", "threads"]
+               if "bench_mode" in metric_df.columns
+               else ["path", "threads"]),
+        columns="size_human",
+        values="mean_ns",
+        aggfunc="first",
+    )
+    pivot = pivot.reindex(
+        sorted(pivot.columns, key=parse_human_size_to_bytes),
+        axis=1,
+    )
+    columns = [str(col) for col in pivot.columns.tolist()]
+    if "bench_mode" in metric_df.columns:
+        f.write("| mode | path | workers | " + " | ".join(columns) + " |\n")
+        f.write("| --- | --- | ---: | " + " | ".join(["---:"] * len(columns)) + " |\n")
+    else:
+        f.write("| path | threads | " + " | ".join(columns) + " |\n")
+        f.write("| --- | ---: | " + " | ".join(["---:"] * len(columns)) + " |\n")
+    for idx, row in pivot.iterrows():
+        values = []
+        for col in pivot.columns:
+            value = row[col]
+            values.append("" if pd.isna(value) else f"{value:.2f}")
+        if "bench_mode" in metric_df.columns:
+            mode, path, threads = idx
+            f.write(f"| {mode} | {path} | {threads} | " + " | ".join(values) + " |\n")
+        else:
+            path, threads = idx
+            f.write(f"| {path} | {threads} | " + " | ".join(values) + " |\n")
+    f.write("\n")
+
+    f.write(f"## {metric_label(metric)} speedup\n\n")
+    speedup_pivot = speedup_df.pivot_table(
+        index=(["bench_mode", "threads"]
+               if "bench_mode" in speedup_df.columns
+               else "threads"),
+        columns="size_human",
+        values="speedup",
+        aggfunc="first",
+    )
+    speedup_pivot = speedup_pivot.reindex(
+        sorted(speedup_pivot.columns, key=parse_human_size_to_bytes),
+        axis=1,
+    )
+    columns = [str(col) for col in speedup_pivot.columns.tolist()]
+    if "bench_mode" in speedup_df.columns:
+        f.write("| mode | workers | " + " | ".join(columns) + " |\n")
+        f.write("| --- | ---: | " + " | ".join(["---:"] * len(columns)) + " |\n")
+    else:
+        f.write("| threads | " + " | ".join(columns) + " |\n")
+        f.write("| ---: | " + " | ".join(["---:"] * len(columns)) + " |\n")
+    for idx, row in speedup_pivot.sort_index().iterrows():
+        values = []
+        for col in speedup_pivot.columns:
+            value = row[col]
+            values.append("" if pd.isna(value) else f"{value:.2f}x")
+        if "bench_mode" in speedup_df.columns:
+            mode, threads = idx
+            f.write(f"| {mode} | {threads} | " + " | ".join(values) + " |\n")
+        else:
+            f.write(f"| {idx} | " + " | ".join(values) + " |\n")
+    f.write("\n")
