+static inline void sharedArenaSpinPause() {
+#if defined(__x86_64__) || defined(__i386__)
+  __asm__ __volatile__("pause" ::: "memory");
+#elif defined(__aarch64__)
+  __asm__ __volatile__("yield" ::: "memory");
+#else
+  __asm__ __volatile__("" ::: "memory");
+#endif
+}
+
+static bool sharedArenaFreeBlockLooksValid(const FreeBlockHeader *Blk,
+                                           u32 PageOff, u32 TotalDataPages) {
+  if (Blk->Magic != kFreeBlockMagic || Blk->SizeInPages == 0)
+    return false;
+  if (PageOff >= TotalDataPages || Blk->SizeInPages > TotalDataPages - PageOff)
+    return false;
+  if (Blk->PrevPageOff != kFreeListEnd && Blk->PrevPageOff >= TotalDataPages)
+    return false;
+  if (Blk->NextPageOff != kFreeListEnd && Blk->NextPageOff >= TotalDataPages)
+    return false;
+  return true;
+}
+
+static void sharedArenaSetZeroRange(FreeBlockHeader *Blk, uptr BlockBase,
+                                    uptr BlockSize, uptr ZeroStart,
+                                    uptr ZeroEnd) {
+  const uptr BlockEnd = BlockBase + BlockSize;
+  if (ZeroStart < BlockBase)
+    ZeroStart = BlockBase;
+  if (ZeroEnd > BlockEnd)
+    ZeroEnd = BlockEnd;
+  if (ZeroStart < ZeroEnd) {
+    Blk->Flags |= kFreeBlockFlagZeroed;
+    Blk->ZeroStart = ZeroStart;
+    Blk->ZeroEnd = ZeroEnd;
+  } else {
+    Blk->Flags &= ~kFreeBlockFlagZeroed;
+    Blk->ZeroStart = 0;
+    Blk->ZeroEnd = 0;
+  }
+}
+
+static u32 sharedArenaSizeClassForPages(u32 Pages) {
+  if (Pages <= 1)
+    return 0;
+  u32 Class = 0;
+  u32 ClassPages = 1;
+  while (Class + 1 < kSharedArenaNumSizeClasses && ClassPages < Pages) {
+    ClassPages <<= 1;
+    Class++;
+  }
+  return Class;
+}
+
+static bool sharedArenaBlockIsFullyZeroed(const FreeBlockHeader *Blk,
+                                          uptr BlockBase, uptr BlockSize) {
+  return (Blk->Flags & kFreeBlockFlagZeroed) != 0 &&
+         Blk->ZeroStart <= BlockBase &&
+         BlockBase + BlockSize <= Blk->ZeroEnd;
+}
+
+static SharedArenaBin &sharedArenaBinFor(SharedArenaHeader *Hdr, u32 Class,
+                                         bool Zeroed) {
+  return Zeroed ? Hdr->ZeroedBins[Class] : Hdr->DirtyBins[Class];
+}
+
+static void sharedArenaResetBins(SharedArenaHeader *Hdr) {
+  for (u32 I = 0; I < kSharedArenaNumSizeClasses; ++I) {
+    Hdr->DirtyBins[I].HeadPageOff = kFreeListEnd;
+    Hdr->DirtyBins[I].Count = 0;
+    Hdr->ZeroedBins[I].HeadPageOff = kFreeListEnd;
+    Hdr->ZeroedBins[I].Count = 0;
+  }
+}
+
+static void sharedArenaResetRemoteFrees(SharedArenaHeader *Hdr) {
+  atomic_store(&Hdr->RemoteFreeHead, 0u, memory_order_relaxed);
+  atomic_store(&Hdr->RemoteFreeTail, 0u, memory_order_relaxed);
+  Hdr->RemoteFreeDropped = 0;
+  Hdr->RemoteFreeEnqueueCount = 0;
+  Hdr->RemoteFreeDrainCount = 0;
+  for (u32 I = 0; I < kSharedArenaRemoteFreeCapacity; ++I)
+    atomic_store(&Hdr->RemoteFrees[I].Seq, 0u, memory_order_relaxed);
+}
+
+// SharedArena::lock / unlock（跨进程用户态 spinlock）
+// ---------------------------------------------------------------------------
+
+void SharedArena::lock() {
+  DCHECK(Hdr != nullptr);
+  u32 Expected = 0u;
+  while (!atomic_compare_exchange_strong(&Hdr->Lock, &Expected, 1u,
+                                         memory_order_acquire)) {
+    do {
+      sharedArenaSpinPause();
+    } while (atomic_load(&Hdr->Lock, memory_order_relaxed) != 0u);
+    Expected = 0u;
+  }
+}
+
+void SharedArena::unlock() {
+  DCHECK(Hdr != nullptr);
+  atomic_store(&Hdr->Lock, 0u, memory_order_release);
+}
+
+bool SharedArena::appendLogLocked(SharedArenaLogOp Op, uptr CommitBase,
+                                  uptr CommitSize, u16 Flags) {
+  const uptr PageSize = getPageSizeCached();
+  if (UNLIKELY(!isAligned(CommitBase, PageSize)))
+    return false;
+
+  return appendLogPagesLocked(Op, static_cast<u8>(CoreId),
+                              addrToPageOff(CommitBase), CommitSize, Flags);
+}
+
+bool SharedArena::appendLogPagesLocked(SharedArenaLogOp Op, u8 SrcCpu,
+                                       u32 StartPage, uptr CommitSize,
+                                       u16 Flags) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  SharedArenaProfileScope Profile(ProfileAppendLog);
+#endif
+
+  // Bench-only no-kernel mode: the kernel does not consume the ring (Head never
+  // advances). Mask out all ring operations so the arena path doesn't
+  // self-disable due to a full ring. NOT safe for production semantics.
+  if (sharedArenaAllowNoKernel())
+    return true;
+
+  DCHECK(LogRing != nullptr);
+
+  const uptr PageSize = getPageSizeCached();
+  if (UNLIKELY(CommitSize == 0 || !isAligned(CommitSize, PageSize)))
+    return false;
+
+  const u32 Capacity = LogCapacityCache;
+  if (UNLIKELY(Capacity == 0))
+    return false;
+
+  u32 Head = LogHeadCache;
+  u32 Tail = LogTailCache;
+  if (UNLIKELY(Tail - Head >= Capacity)) {
+    Head = atomic_load(&LogRing->Head, memory_order_acquire);
+    LogHeadCache = Head;
+    if (UNLIKELY(Tail - Head >= Capacity)) {
+      sched_yield();
+      Head = atomic_load(&LogRing->Head, memory_order_acquire);
+      LogHeadCache = Head;
+      if (UNLIKELY(Tail - Head >= Capacity)) {
+        const u64 DrainStart = getMonotonicTime();
+        const long Ret =
+            prctl(PR_SET_MEMORY_DELEGATION_LOG, 0UL,
+                  PR_MEMORY_DELEGATION_F_DRAIN_LOG,
+                  static_cast<unsigned long>(CoreId),
+                  static_cast<unsigned long>(DataBase));
+        atomic_fetch_add(&SharedArenaActiveDrainCalls, 1ULL,
+                         memory_order_relaxed);
+        atomic_fetch_add(&SharedArenaActiveDrainNs,
+                         getMonotonicTime() - DrainStart,
+                         memory_order_relaxed);
+        if (Ret >= 0) {
+          atomic_fetch_add(&SharedArenaActiveDrainSuccess, 1ULL,
+                           memory_order_relaxed);
+          Head = atomic_load(&LogRing->Head, memory_order_acquire);
+          LogHeadCache = Head;
+        } else {
+          atomic_fetch_add(&SharedArenaActiveDrainFailed, 1ULL,
+                           memory_order_relaxed);
+        }
+        if (UNLIKELY(Tail - Head >= Capacity)) {
+          atomic_fetch_add(&LogRing->Dropped, 1u, memory_order_relaxed);
+          return false;
+        }
+      }
+    }
+  }
+
+  DCHECK(isPowerOfTwo(static_cast<uptr>(Capacity)));
+  SharedArenaLogEntry *Entries = getLogEntries();
+  SharedArenaLogEntry &Entry = Entries[Tail & LogCapacityMask];
+  Entry.Op = static_cast<u8>(Op);
+  Entry.SrcCpu = SrcCpu;
+  Entry.Flags = Flags;
+  Entry.StartPage = StartPage;
+  Entry.NumPages = static_cast<u32>(CommitSize / PageSize);
+  const u32 NewTail = Tail + 1;
+  atomic_store(&LogRing->Tail, NewTail, memory_order_release);
+  LogTailCache = NewTail;
+  return true;
+}
+
+bool SharedArena::drainLogRingForCurrentProcessLocked() {
+  if (sharedArenaAllowNoKernel())
+    return true;
+
+  const u64 DrainStart = getMonotonicTime();
+  const long Ret =
+      prctl(PR_SET_MEMORY_DELEGATION_LOG, 0UL,
+            PR_MEMORY_DELEGATION_F_DRAIN_LOG,
+            static_cast<unsigned long>(CoreId),
+            static_cast<unsigned long>(DataBase));
+  atomic_fetch_add(&SharedArenaActiveDrainCalls, 1ULL, memory_order_relaxed);
+  atomic_fetch_add(&SharedArenaActiveDrainNs, getMonotonicTime() - DrainStart,
+                   memory_order_relaxed);
+  if (Ret >= 0) {
+    atomic_fetch_add(&SharedArenaActiveDrainSuccess, 1ULL,
+                     memory_order_relaxed);
+    if (LogRing != nullptr)
+      LogHeadCache = atomic_load(&LogRing->Head, memory_order_acquire);
+    return true;
+  }
+
+  atomic_fetch_add(&SharedArenaActiveDrainFailed, 1ULL, memory_order_relaxed);
+  sharedArenaTrace("active drain failed core=%u data_base=0x%zx errno=%d",
+                   CoreId, DataBase, errno);
+  return false;
+}
+
+bool SharedArena::initLogRing() {
+  DCHECK(LogRing == nullptr);
+
+  const uptr PageSize = getPageSizeCached();
+  void *RingMem = mmap(nullptr, PageSize, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  if (RingMem == MAP_FAILED)
+    return false;
+
+  memset(RingMem, 0, PageSize);
+  LogRing = reinterpret_cast<SharedArenaLogRing *>(RingMem);
+  LogRingSize = PageSize;
+
+  const uptr HeaderBytes = sizeof(*LogRing);
+  if (UNLIKELY(HeaderBytes >= PageSize)) {
+    munmap(RingMem, PageSize);
+    LogRing = nullptr;
+    LogRingSize = 0;
+    LogHeadCache = 0;
+    LogTailCache = 0;
+    LogCapacityCache = 0;
+    LogCapacityMask = 0;
+    return false;
+  }
+
+  const u32 RawCapacity = static_cast<u32>((PageSize - HeaderBytes) /
+                                           sizeof(SharedArenaLogEntry));
+  if (UNLIKELY(RawCapacity == 0)) {
+    munmap(RingMem, PageSize);
+    LogRing = nullptr;
+    LogRingSize = 0;
+    LogHeadCache = 0;
+    LogTailCache = 0;
+    LogCapacityCache = 0;
+    LogCapacityMask = 0;
+    return false;
+  }
+  const u32 Capacity =
+      static_cast<u32>(1u << getMostSignificantSetBitIndex(RawCapacity));
+
+  LogRing->Magic = kLogRingMagic;
+  LogRing->Version = kLogRingVersion;
+  LogRing->Flags = 0;
+  LogRing->Capacity = Capacity;
+  LogRing->ArenaNrPages = Hdr->TotalDataPages;
+  LogRing->RingSize = static_cast<u32>(PageSize);
+  atomic_store(&LogRing->Head, 0u, memory_order_relaxed);
+  atomic_store(&LogRing->Tail, 0u, memory_order_relaxed);
+  atomic_store(&LogRing->Dropped, 0u, memory_order_relaxed);
+  LogRing->Reserved = 0;
+  LogHeadCache = 0;
+  LogTailCache = 0;
+  LogCapacityCache = Capacity;
+  LogCapacityMask = Capacity - 1;
+  return true;
+}
+
+bool SharedArena::registerWithKernel() {
+  DCHECK(LogRing != nullptr);
+
+  const bool ResetOnInit = sharedArenaResetOnInitEnabled();
+  long Ret = prctl(PR_SET_MEMORY_DELEGATION_LOG,
+                   reinterpret_cast<unsigned long>(LogRing),
+                   ResetOnInit ? PR_MEMORY_DELEGATION_F_RESET_ARENA : 0UL,
+                   static_cast<unsigned long>(CoreId),
+                   static_cast<unsigned long>(DataBase));
+  if (Ret != 0 && ResetOnInit &&
+      (errno == EINVAL || errno == EOPNOTSUPP || errno == ENOSYS)) {
+    const int ResetErrno = errno;
+    sharedArenaTrace(
+        "arena register core=%u reset flag unsupported errno=%d, retrying without reset",
+        CoreId, ResetErrno);
+    errno = 0;
+    Ret = prctl(PR_SET_MEMORY_DELEGATION_LOG,
+                reinterpret_cast<unsigned long>(LogRing), 0UL,
+                static_cast<unsigned long>(CoreId),
+                static_cast<unsigned long>(DataBase));
+  }
+  if (Ret == 0)
+    return true;
+
+  // NOTE: DESIGN.md assumes kernel support for the delegation log. For
+  // microbench only, allow a best-effort fallback when the kernel does not
+  // recognize the prctl (EINVAL). This disables kernel-side ownership tracking
+  // and is NOT safe for production use.
+  if (errno == EINVAL && sharedArenaAllowNoKernel()) {
+    sharedArenaTrace("arena register core=%u: kernel prctl unsupported (EINVAL), "
+                     "continuing due to SCUDO_SHARED_ARENA_ALLOW_NO_KERNEL=1",
+                     CoreId);
+    return true;
+  }
+
+  sharedArenaTrace("arena register core=%u data_base=0x%zx ring=0x%zx failed ret=%ld errno=%d",
+                   CoreId, DataBase, reinterpret_cast<uptr>(LogRing), Ret,
+                   errno);
+  return false;
+}
+
+bool SharedArena::refreshLogRingForCurrentProcess() {
+  if (!Initialized)
+    return true;
+
+  if (UNLIKELY(ShmFd < 0 || BaseAddr == 0)) {
+    sharedArenaTrace("arena refresh core=%u missing backing fd/base", CoreId);
+    return false;
+  }
+
+  void *P = mmap(reinterpret_cast<void *>(BaseAddr), kArenaCapacityPerCore,
+                 PROT_READ | PROT_WRITE,
+                 MAP_SHARED | MAP_FIXED | MAP_NORESERVE, ShmFd, 0);
+  if (P == MAP_FAILED) {
+    sharedArenaTrace("arena refresh core=%u remap failed base=0x%zx errno=%d",
+                     CoreId, BaseAddr, errno);
+    return false;
+  }
+  Hdr = reinterpret_cast<SharedArenaHeader *>(BaseAddr);
+
+  if (LogRing != nullptr && LogRingSize != 0)
+    munmap(reinterpret_cast<void *>(LogRing), LogRingSize);
+  LogRing = nullptr;
+  LogRingSize = 0;
+  LogHeadCache = 0;
+  LogTailCache = 0;
+  LogCapacityCache = 0;
+  LogCapacityMask = 0;
+
+  if (!initLogRing())
+    return false;
+  return registerWithKernel();
+}
+
+// ---------------------------------------------------------------------------
+// SharedArena::releasePages — 释放 Arena 内指定范围的物理页（DESIGN.md §2.1）
+//
+// 使用 madvise(MADV_REMOVE) 在 tmpfs/shmem 上打孔，真正释放物理内存。
+// 后续对该范围的读取将触发 page fault 并返回零页。
+// 场景：Arena 元数据槽位满时，无法将块记入 freelist，改为直接释放物理页。
+// ---------------------------------------------------------------------------
+
+bool SharedArena::releasePages(uptr Addr, uptr Size) {
+  if (UNLIKELY(!Initialized || Size == 0))
+    return false;
+
+  const uptr PageSize = getPageSizeCached();
+  const uptr AlignedAddr = roundUp(Addr, PageSize);
+  const uptr AlignedEnd = roundDown(Addr + Size, PageSize);
+  if (AlignedAddr >= AlignedEnd)
+    return false;
+
+  const uptr AlignedSize = AlignedEnd - AlignedAddr;
+  return madvise(reinterpret_cast<void *>(AlignedAddr), AlignedSize,
+                 MADV_REMOVE) == 0;
+}
+
+bool SharedArena::publishFreeBlockLocked(u32 PageOff, u32 Pages,
+                                         uptr ZeroStart, uptr ZeroEnd) {
+  if (UNLIKELY(PageOff >= Hdr->TotalDataPages || Pages == 0 ||
+               Pages > Hdr->TotalDataPages - PageOff))
+    return false;
+
+  const uptr PageSize = getPageSizeCached();
+  const uptr BlockBase = pageOffToAddr(PageOff);
+  const uptr BlockSize = static_cast<uptr>(Pages) * PageSize;
+  FreeBlockHeader *Blk = getFreeBlock(PageOff);
+  Blk->PrevPageOff = kFreeListEnd;
+  Blk->NextPageOff = kFreeListEnd;
+  Blk->SizeInPages = Pages;
+  Blk->Magic = kFreeBlockMagic;
+  Blk->BinPrevPageOff = kFreeListEnd;
+  Blk->BinNextPageOff = kFreeListEnd;
+  Blk->Flags = 0;
+  Blk->ZeroStart = 0;
+  Blk->ZeroEnd = 0;
+  sharedArenaSetZeroRange(Blk, BlockBase, BlockSize, ZeroStart, ZeroEnd);
+
+  linkGlobalFreeBlockLocked(PageOff);
+
+  const bool FullyZeroed = sharedArenaBlockIsFullyZeroed(Blk, BlockBase,
+                                                        BlockSize);
+  const u32 Class = sharedArenaSizeClassForPages(Pages);
+  SharedArenaBin &Bin = sharedArenaBinFor(Hdr, Class, FullyZeroed);
+  Blk->BinNextPageOff = Bin.HeadPageOff;
+  if (Bin.HeadPageOff != kFreeListEnd)
+    getFreeBlock(Bin.HeadPageOff)->BinPrevPageOff = PageOff;
+  Bin.HeadPageOff = PageOff;
+  Bin.Count++;
+  Hdr->FreeCount++;
+  return true;
+}
+
+void SharedArena::linkGlobalFreeBlockLocked(u32 PageOff) {
+  u32 Prev = kFreeListEnd;
+  u32 Next = Hdr->FreeListHeadPageOff;
+
+  if (FreeListInsertHintPageOff != kFreeListEnd &&
+      FreeListInsertHintPageOff < PageOff) {
+    FreeBlockHeader *Hint = getFreeBlock(FreeListInsertHintPageOff);
+    if (sharedArenaFreeBlockLooksValid(Hint, FreeListInsertHintPageOff,
+                                       Hdr->TotalDataPages)) {
+      Prev = FreeListInsertHintPageOff;
+      Next = Hint->NextPageOff;
+    } else {
+      FreeListInsertHintPageOff = kFreeListEnd;
+    }
+  }
+
+  while (Next != kFreeListEnd && Next < PageOff) {
+    FreeBlockHeader *Cur = getFreeBlock(Next);
+    if (!sharedArenaFreeBlockLooksValid(Cur, Next, Hdr->TotalDataPages))
+      break;
+    Prev = Next;
+    Next = Cur->NextPageOff;
+  }
+
+  FreeBlockHeader *Blk = getFreeBlock(PageOff);
+  Blk->PrevPageOff = Prev;
+  Blk->NextPageOff = Next;
+  if (Prev != kFreeListEnd)
+    getFreeBlock(Prev)->NextPageOff = PageOff;
+  else
+    Hdr->FreeListHeadPageOff = PageOff;
+  if (Next != kFreeListEnd)
+    getFreeBlock(Next)->PrevPageOff = PageOff;
+  FreeListInsertHintPageOff = PageOff;
+}
+
+void SharedArena::unlinkGlobalFreeBlockLocked(u32 PageOff,
+                                              FreeBlockHeader *Blk) {
+  if (FreeListInsertHintPageOff == PageOff) {
+    if (Blk->PrevPageOff != kFreeListEnd)
+      FreeListInsertHintPageOff = Blk->PrevPageOff;
+    else if (Blk->NextPageOff != kFreeListEnd)
+      FreeListInsertHintPageOff = Blk->NextPageOff;
+    else
+      FreeListInsertHintPageOff = kFreeListEnd;
+  }
+
+  if (Blk->PrevPageOff != kFreeListEnd)
+    getFreeBlock(Blk->PrevPageOff)->NextPageOff = Blk->NextPageOff;
+  else if (Hdr->FreeListHeadPageOff == PageOff)
+    Hdr->FreeListHeadPageOff = Blk->NextPageOff;
+  if (Blk->NextPageOff != kFreeListEnd)
+    getFreeBlock(Blk->NextPageOff)->PrevPageOff = Blk->PrevPageOff;
+  Blk->PrevPageOff = kFreeListEnd;
+  Blk->NextPageOff = kFreeListEnd;
+}
+
+bool SharedArena::tryPopFreeBlockLocked(u32 NeededPages, bool PreferZeroed,
+                                        bool AllowDirty, uptr Size,
+                                        uptr Alignment, uptr HeadersSize,
+                                        uptr &OutBase, uptr &OutSize,
+                                        uptr &OutHeaderPos,
+                                        bool &OutZeroed) {
+  const uptr PageSize = getPageSizeCached();
+  const u32 StartClass = sharedArenaSizeClassForPages(NeededPages);
+  const bool CanSplit = sharedArenaFreelistSplitEnabled();
+
+  for (u32 Pass = 0; Pass < 2; ++Pass) {
+    const bool WantZeroed = (Pass == 0) ? PreferZeroed : !PreferZeroed;
+    if (!WantZeroed && !AllowDirty)
+      continue;
+
+    for (u32 Class = StartClass; Class < kSharedArenaNumSizeClasses; ++Class) {
+      SharedArenaBin &Bin = sharedArenaBinFor(Hdr, Class, WantZeroed);
+      u32 Off = Bin.HeadPageOff;
+      while (Off != kFreeListEnd) {
+        FreeBlockHeader *Blk = getFreeBlock(Off);
+        const u32 Next = Blk->BinNextPageOff;
+        if (UNLIKELY(!sharedArenaFreeBlockLooksValid(
+                Blk, Off, Hdr->TotalDataPages))) {
+          sharedArenaTrace("bin corrupt core=%u class=%u off=%u magic=0x%x pages=%u",
+                           CoreId, Class, Off, Blk->Magic, Blk->SizeInPages);
+          Bin.HeadPageOff = Next;
+          if (Next != kFreeListEnd)
+            getFreeBlock(Next)->BinPrevPageOff = kFreeListEnd;
+          if (Bin.Count != 0)
+            Bin.Count--;
+          Hdr->FreeCount = Hdr->FreeCount != 0 ? Hdr->FreeCount - 1 : 0;
+          Blk->Magic = 0;
+          Off = Next;
+          continue;
+        }
+        if (Blk->SizeInPages < NeededPages) {
+          Off = Next;
+          continue;
+        }
+
+        unlinkGlobalFreeBlockLocked(Off, Blk);
+        if (Blk->BinPrevPageOff != kFreeListEnd)
+          getFreeBlock(Blk->BinPrevPageOff)->BinNextPageOff =
+              Blk->BinNextPageOff;
+        else
+          Bin.HeadPageOff = Blk->BinNextPageOff;
+        if (Blk->BinNextPageOff != kFreeListEnd)
+          getFreeBlock(Blk->BinNextPageOff)->BinPrevPageOff =
+              Blk->BinPrevPageOff;
+        if (Bin.Count != 0)
+          Bin.Count--;
+        if (Hdr->FreeCount != 0)
+          Hdr->FreeCount--;
+
+        const u32 OldPages = Blk->SizeInPages;
+        const u32 AllocPages = CanSplit ? NeededPages : OldPages;
+        const u32 Remainder = OldPages - AllocPages;
+        const u32 SavedFlags = Blk->Flags;
+        const uptr SavedZeroStart = Blk->ZeroStart;
+        const uptr SavedZeroEnd = Blk->ZeroEnd;
+        Blk->Magic = 0;
+        Blk->Flags = 0;
+
+        if (Remainder != 0) {
+          publishFreeBlockLocked(Off + AllocPages, Remainder, SavedZeroStart,
+                                 SavedZeroEnd);
+        }
+
+        const u32 AllocOff = Off;
+        OutBase = pageOffToAddr(AllocOff);
+        OutSize = static_cast<uptr>(AllocPages) * PageSize;
+        const uptr UserBegin = roundUp(OutBase + HeadersSize, Alignment);
+        OutHeaderPos = UserBegin - HeadersSize;
+        if (UNLIKELY(OutHeaderPos < OutBase ||
+                     UserBegin + Size > OutBase + OutSize)) {
+          publishFreeBlockLocked(AllocOff, AllocPages, SavedZeroStart,
+                                 SavedZeroEnd);
+          OutBase = 0;
+          OutSize = 0;
+          OutHeaderPos = 0;
+          return false;
+        }
+        OutZeroed = (SavedFlags & kFreeBlockFlagZeroed) != 0 &&
+                    SavedZeroStart <= UserBegin &&
+                    UserBegin + Size <= SavedZeroEnd;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+void SharedArena::drainRemoteFreesLocked(u32 MaxToDrain) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  SharedArenaProfileScope Profile(ProfileRemoteDrain);
+#endif
+  if (sharedArenaFreelistDisabled())
+    return;
+
+  const uptr PageSize = getPageSizeCached();
+  u32 Drained = 0;
+  while (Drained < MaxToDrain) {
+    const u32 Head = atomic_load(&Hdr->RemoteFreeHead, memory_order_relaxed);
+    const u32 Tail = atomic_load(&Hdr->RemoteFreeTail, memory_order_acquire);
+    if (Head == Tail)
+      break;
+
+    SharedArenaRemoteFreeDesc &Desc =
+        Hdr->RemoteFrees[Head & (kSharedArenaRemoteFreeCapacity - 1)];
+    if (atomic_load(&Desc.Seq, memory_order_acquire) != Head + 1)
+      break;
+
+    const uptr CommitSize = static_cast<uptr>(Desc.Pages) * PageSize;
+    if (publishFreeBlockLocked(Desc.PageOff, Desc.Pages, Desc.ZeroStart,
+                               Desc.ZeroEnd)) {
+      Hdr->TotalDonatedBytes += CommitSize;
+      Hdr->DonateCount++;
+      Hdr->RemoteFreeDrainCount++;
+    }
+
+    atomic_store(&Desc.Seq, 0u, memory_order_release);
+    atomic_store(&Hdr->RemoteFreeHead, Head + 1, memory_order_release);
+    Drained++;
+  }
+}
+
+bool SharedArena::enqueueRemoteFree(uptr CommitBase, uptr CommitSize,
+                                    uptr ZeroStart, uptr ZeroSize) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  SharedArenaProfileScope Profile(ProfileRemoteEnqueue);
+#endif
+  const uptr PageSize = getPageSizeCached();
+  if (UNLIKELY(!isAligned(CommitBase, PageSize) ||
+               !isAligned(CommitSize, PageSize)))
+    return false;
+
+  const u32 PageOff = addrToPageOff(CommitBase);
+  const u32 Pages = static_cast<u32>(CommitSize / PageSize);
+  if (UNLIKELY(PageOff >= Hdr->TotalDataPages || Pages == 0 ||
+               Pages > Hdr->TotalDataPages - PageOff))
+    return false;
+
+  FreeBlockHeader *Pending = getFreeBlock(PageOff);
+  Pending->SizeInPages = Pages;
+  Pending->Magic = kFreeBlockPendingMagic;
+  Pending->Flags = kFreeBlockFlagRemotePending;
+  sharedArenaSetZeroRange(Pending, CommitBase, CommitSize, ZeroStart,
+                          ZeroStart + ZeroSize);
+
+  while (true) {
+    const u32 Head = atomic_load(&Hdr->RemoteFreeHead, memory_order_acquire);
+    u32 Tail = atomic_load(&Hdr->RemoteFreeTail, memory_order_relaxed);
+    if (Tail - Head >= kSharedArenaRemoteFreeCapacity) {
+      Hdr->RemoteFreeDropped++;
+      return false;
+    }
+    u32 Expected = Tail;
+    if (!atomic_compare_exchange_strong(&Hdr->RemoteFreeTail, &Expected,
+                                        Tail + 1, memory_order_acq_rel))
+      continue;
+
+    SharedArenaRemoteFreeDesc &Desc =
+        Hdr->RemoteFrees[Tail & (kSharedArenaRemoteFreeCapacity - 1)];
+    Desc.PageOff = PageOff;
+    Desc.Pages = Pages;
+    Desc.Flags = Pending->Flags;
+    Desc.ZeroStart = Pending->ZeroStart;
+    Desc.ZeroEnd = Pending->ZeroEnd;
+    atomic_store(&Desc.Seq, Tail + 1, memory_order_release);
+    Hdr->RemoteFreeEnqueueCount++;
+    return true;
+  }
+}
+
+bool SharedArena::storeRemote(uptr CommitBase, uptr CommitSize,
+                              uptr ZeroStart, uptr ZeroSize) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  SharedArenaProfileScope Profile(ProfileRemoteStore);
+#endif
+  if (UNLIKELY(!Initialized || CommitSize == 0))
+    return false;
+
+  if (!sharedArenaRemoteFreeQueueEnabled())
+    return store(CommitBase, CommitSize, ZeroStart, ZeroSize);
+
+  const uptr PageSize = getPageSizeCached();
+  const u32 NewPageOff = addrToPageOff(CommitBase);
+  const u32 NewPages = static_cast<u32>(CommitSize / PageSize);
+  if (UNLIKELY(!isAligned(CommitBase, PageSize) ||
+               !isAligned(CommitSize, PageSize) ||
+               NewPageOff >= Hdr->TotalDataPages || NewPages == 0 ||
+               NewPages > Hdr->TotalDataPages - NewPageOff)) {
+    sharedArenaTrace("store remote invalid range core=%u base=0x%zx size=%zu page_off=%u pages=%u total=%u",
+                     CoreId, CommitBase, CommitSize, NewPageOff, NewPages,
+                     Hdr != nullptr ? Hdr->TotalDataPages : 0);
+    return false;
+  }
+
+  lock();
+  if (UNLIKELY(!appendLogPagesLocked(SharedArenaLogOp::Free,
+                                     static_cast<u8>(CoreId), NewPageOff,
+                                     CommitSize))) {
+    unlock();
+    sharedArenaTrace(
+        "remote log append failed owner_core=%u base=0x%zx size=%zu",
+        CoreId, CommitBase, CommitSize);
+    return false;
+  }
+
+  if (UNLIKELY(!drainLogRingForCurrentProcessLocked())) {
+    unlock();
+    return false;
+  }
+
+  if (enqueueRemoteFree(CommitBase, CommitSize, ZeroStart, ZeroSize)) {
+    unlock();
+    return true;
+  }
+
+  drainRemoteFreesLocked(kSharedArenaRemoteFreeCapacity);
+
+  if (enqueueRemoteFree(CommitBase, CommitSize, ZeroStart, ZeroSize)) {
+    unlock();
+    return true;
+  }
+
+  if (publishFreeBlockLocked(NewPageOff, NewPages, ZeroStart,
+                             ZeroStart + ZeroSize)) {
+    Hdr->TotalDonatedBytes += CommitSize;
+    Hdr->DonateCount++;
+    unlock();
+    sharedArenaMaybeDumpAllocStats("shared_arena_store_remote_fallback");
+    return true;
+  }
+
+  unlock();
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// SharedArena::init
+// ---------------------------------------------------------------------------
+
+bool SharedArena::init(u32 Id) {
+  CoreId   = Id;
+  BaseAddr = kSharedArenaBaseAddr + static_cast<uptr>(Id) * kArenaCapacityPerCore;
+  DataBase = BaseAddr + kArenaHeaderSize;
+  FreeListInsertHintPageOff = kFreeListEnd;
+
+  int Fd = -1;
+#if SCUDO_ANDROID
+  switch (SharedArenaInitMode) {
+  case SharedArenaAndroidInitMode::Attach:
+    if (!sharedArenaGetInheritedFd(Id, Fd))
+      Fd = sharedArenaRequestBrokerFd(Id);
+    if (Fd < 0) {
+      sharedArenaTrace("arena init core=%u attach failed", Id);
+      return false;
+    }
+    break;
+  case SharedArenaAndroidInitMode::Unknown:
+  default:
+    sharedArenaTrace("arena init core=%u unknown init mode", Id);
+    return false;
+  }
+#else
+  char ShmName[64];
+  snprintf(ShmName, sizeof(ShmName), "/scudo_arena_%u", Id);
+
+  Fd = shm_open(ShmName, O_CREAT | O_RDWR, 0600);
+  if (Fd < 0)
+    return false;
+
+  if (ftruncate(Fd, static_cast<off_t>(kArenaCapacityPerCore)) != 0) {
+    close(Fd);
+    return false;
+  }
+#endif
+
+  void *P = mmap(reinterpret_cast<void *>(BaseAddr), kArenaCapacityPerCore,
+                 PROT_READ | PROT_WRITE,
+                 MAP_SHARED | MAP_FIXED_NOREPLACE | MAP_NORESERVE, Fd, 0);
+  if (P == MAP_FAILED) {
+    sharedArenaTrace("arena init core=%u mmap failed base=0x%zx errno=%d", Id,
+                     BaseAddr, errno);
+    close(Fd);
+    return false;
+  }
+
+  ShmFd = Fd;
+  Hdr   = reinterpret_cast<SharedArenaHeader *>(BaseAddr);
+
+  const uptr PageSize = getPageSizeCached();
+  const u32 TotalDataPages =
+      static_cast<u32>((kArenaCapacityPerCore - kArenaHeaderSize) / PageSize);
+
+  // CAS Version 0 → 1：首次初始化者负责写入元数据。
+  u32 Expected = 0u;
+  if (atomic_compare_exchange_strong(&Hdr->Version, &Expected, 1u,
+                                      memory_order_acq_rel)) {
+    atomic_store(&Hdr->Lock, 0u, memory_order_relaxed);
+    Hdr->BumpOffsetInPages    = 0;
+    Hdr->TotalDataPages       = TotalDataPages;
+    Hdr->FreeListHeadPageOff  = kFreeListEnd;
+    Hdr->FreeCount            = 0;
+    Hdr->TotalDonatedBytes    = 0;
+    Hdr->TotalRetrievedBytes  = 0;
+    Hdr->DonateCount          = 0;
+    Hdr->RetrieveCount        = 0;
+    sharedArenaResetBins(Hdr);
+    sharedArenaResetRemoteFrees(Hdr);
+    atomic_store(&Hdr->Version, 2u, memory_order_release);
+  } else {
+    while (atomic_load(&Hdr->Version, memory_order_acquire) < 2u)
+      ;
+  }
+
+  if (!initLogRing()) {
+    munmap(reinterpret_cast<void *>(BaseAddr), kArenaCapacityPerCore);
+    close(Fd);
+    Hdr = nullptr;
+    ShmFd = -1;
+    return false;
+  }
+
+  if (!registerWithKernel()) {
+    munmap(reinterpret_cast<void *>(LogRing), LogRingSize);
+    LogRing = nullptr;
+    LogRingSize = 0;
+    LogHeadCache = 0;
+    LogTailCache = 0;
+    LogCapacityCache = 0;
+    LogCapacityMask = 0;
+    munmap(reinterpret_cast<void *>(BaseAddr), kArenaCapacityPerCore);
+    close(Fd);
+    Hdr = nullptr;
+    ShmFd = -1;
+    return false;
+  }
+
+  Initialized = true;
+  sharedArenaTrace("arena init core=%u success base=0x%zx fd=%d", Id, BaseAddr,
+                   Fd);
+  return true;
+}
+
+void SharedArena::reset() {
+  if (UNLIKELY(!Initialized || Hdr == nullptr))
+    return;
+
+  const uptr PageSize = getPageSizeCached();
+  const u32 TotalDataPages =
+      static_cast<u32>((kArenaCapacityPerCore - kArenaHeaderSize) / PageSize);
+
+  lock();
+  Hdr->BumpOffsetInPages   = 0;
+  Hdr->TotalDataPages      = TotalDataPages;
+  Hdr->FreeListHeadPageOff = kFreeListEnd;
+  FreeListInsertHintPageOff = kFreeListEnd;
+  Hdr->FreeCount           = 0;
+  Hdr->TotalDonatedBytes   = 0;
+  Hdr->TotalRetrievedBytes = 0;
+  Hdr->DonateCount         = 0;
+  Hdr->RetrieveCount       = 0;
+  sharedArenaResetBins(Hdr);
+  sharedArenaResetRemoteFrees(Hdr);
+  unlock();
+
+  if (LIKELY(LogRing != nullptr)) {
+    LogRing->ArenaNrPages = TotalDataPages;
+    atomic_store(&LogRing->Head, 0u, memory_order_relaxed);
+    atomic_store(&LogRing->Tail, 0u, memory_order_relaxed);
+    atomic_store(&LogRing->Dropped, 0u, memory_order_relaxed);
+    LogHeadCache = 0;
+    LogTailCache = 0;
+    LogCapacityCache = LogRing->Capacity;
+    LogCapacityMask = LogRing->Capacity - 1;
+  }
+
+  const uptr DataSize = kArenaCapacityPerCore - kArenaHeaderSize;
+  (void)releasePages(DataBase, DataSize);
+}
+
+// ---------------------------------------------------------------------------
+// SharedArena::store — VA 有序插入 + 前后合并（DESIGN.md §2.2）
+//
+// 将一个块归还到侵入式空闲链表。按 VA 地址找到插入位置，写入
+// FreeBlockHeader，并尝试与前后相邻的空闲块合并。
+// 侵入式链表无容量上限，永远成功。
+// ---------------------------------------------------------------------------
+
+bool SharedArena::store(uptr CommitBase, uptr CommitSize, uptr ZeroStart,
+                        uptr ZeroSize) {
+  if (UNLIKELY(!Initialized || CommitSize == 0))
+    return false;
+
+  const uptr PageSize = getPageSizeCached();
+  const u32 NewPageOff = addrToPageOff(CommitBase);
+  const u32 NewPages   = static_cast<u32>(CommitSize / PageSize);
+  if (UNLIKELY(!isAligned(CommitBase, PageSize) ||
+               !isAligned(CommitSize, PageSize) ||
+               NewPageOff >= Hdr->TotalDataPages ||
+               NewPages == 0 || NewPages > Hdr->TotalDataPages - NewPageOff)) {
+    sharedArenaTrace("store invalid range core=%u base=0x%zx size=%zu page_off=%u pages=%u total=%u",
+                     CoreId, CommitBase, CommitSize, NewPageOff, NewPages,
+                     Hdr != nullptr ? Hdr->TotalDataPages : 0);
+    return false;
+  }
+  lock();
+  if (UNLIKELY(!appendLogPagesLocked(SharedArenaLogOp::Free,
+                                     static_cast<u8>(CoreId), NewPageOff,
+                                     CommitSize))) {
+    unlock();
+    sharedArenaTrace(
+        "log append failed on free owner_core=%u base=0x%zx size=%zu",
+        CoreId, CommitBase, CommitSize);
+    return false;
+  }
+
+  if (UNLIKELY(sharedArenaFreelistDisabled())) {
+    Hdr->TotalDonatedBytes += CommitSize;
+    Hdr->DonateCount++;
+    unlock();
+    sharedArenaMaybeDumpAllocStats("shared_arena_store");
+    sharedArenaTrace("store quarantine core=%u commit_base=0x%zx commit_size=%zu page_off=%u pages=%u",
+                     CoreId, CommitBase, CommitSize, NewPageOff, NewPages);
+    return true;
+  }
+
+  if (UNLIKELY(!drainLogRingForCurrentProcessLocked())) {
+    unlock();
+    return false;
+  }
+
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  const bool Profile = sharedArenaProfileEnabled();
+  const u64 StoreInsertMergeStart = Profile ? getMonotonicTime() : 0;
+#endif
+  drainRemoteFreesLocked(8);
+  if (UNLIKELY(!publishFreeBlockLocked(NewPageOff, NewPages, ZeroStart,
+                                       ZeroStart + ZeroSize))) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    if (Profile)
+      sharedArenaProfileRecord(ProfileStoreInsertMerge,
+                               getMonotonicTime() - StoreInsertMergeStart);
+#endif
+    unlock();
+    return false;
+  }
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  if (Profile)
+    sharedArenaProfileRecord(ProfileStoreInsertMerge,
+                             getMonotonicTime() - StoreInsertMergeStart);
+#endif
+
+  Hdr->TotalDonatedBytes += CommitSize;
+  Hdr->DonateCount++;
+
+  unlock();
+  sharedArenaMaybeDumpAllocStats("shared_arena_store");
+  sharedArenaTrace("store core=%u commit_base=0x%zx commit_size=%zu page_off=%u pages=%u",
+                   CoreId, CommitBase, CommitSize, NewPageOff, NewPages);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// SharedArena::retrieve — size-class bin + remote drain + bump fallback
+//
+// 分配优先级：
+//  1. 按 Fill 策略从 Dirty/Zeroed size-class bin O(1) 取块。
+//  2. 未命中则 drain remote-free descriptor 并重试 bin。
+//  3. 再未命中则用 Bump 指针分配（page fault 按需提交）。
+//  4. 均无可用则返回 false，上层回退到 cache/mmap。
+// ---------------------------------------------------------------------------
+
+bool SharedArena::retrieve(uptr Size, uptr Alignment, uptr HeadersSize,
+                            uptr &OutCommitBase, uptr &OutCommitSize,
+                            uptr &OutEntryHeaderPos, bool RequireZeroed,
+                            bool &OutZeroed) {
+  if (UNLIKELY(!Initialized))
+    return false;
+
+  const uptr PageSize    = getPageSizeCached();
+  const uptr NeededSize  = roundUp(Size + HeadersSize, PageSize);
+  const u32  NeededPages = static_cast<u32>(NeededSize / PageSize);
+
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  const bool Profile = sharedArenaProfileEnabled();
+  const u64 LockStart = Profile ? getMonotonicTime() : 0;
+#endif
+  lock();
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  if (Profile)
+    sharedArenaProfileRecord(ProfileRetrieveLockWait,
+                             getMonotonicTime() - LockStart);
+#endif
+
+  uptr AllocBase = 0;
+  uptr AllocSize = 0;
+  uptr HeaderPos = 0;
+  bool Zeroed = true;
+  bool FromBump = false;
+
+  if (!sharedArenaFreelistDisabled() && Hdr->FreeCount != 0) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    const u64 ScanStart = Profile ? getMonotonicTime() : 0;
+#endif
+    (void)tryPopFreeBlockLocked(NeededPages, RequireZeroed,
+                                /*AllowDirty=*/true, Size, Alignment,
+                                HeadersSize, AllocBase, AllocSize, HeaderPos,
+                                Zeroed);
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    if (Profile)
+      sharedArenaProfileRecord(ProfileFreelistScan,
+                               getMonotonicTime() - ScanStart);
+#endif
+  }
+
+  if (AllocBase == 0 && !sharedArenaFreelistDisabled()) {
+    drainRemoteFreesLocked(kSharedArenaRemoteFreeCapacity);
+    (void)tryPopFreeBlockLocked(NeededPages, RequireZeroed,
+                                /*AllowDirty=*/true, Size, Alignment,
+                                HeadersSize, AllocBase, AllocSize, HeaderPos,
+                                Zeroed);
+  }
+
+  if (AllocBase == 0 && !sharedArenaBumpDisabled()) {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    const u64 BumpStart = Profile ? getMonotonicTime() : 0;
+#endif
+    const u32 BumpOff = Hdr->BumpOffsetInPages;
+    if (BumpOff + NeededPages <= Hdr->TotalDataPages) {
+      AllocBase = pageOffToAddr(BumpOff);
+      AllocSize = NeededSize;
+      Zeroed = true;
+      Hdr->BumpOffsetInPages = BumpOff + NeededPages;
+      FromBump = true;
+    }
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    if (Profile)
+      sharedArenaProfileRecord(ProfileBump, getMonotonicTime() - BumpStart);
+#endif
+  } else if (AllocBase == 0) {
+    sharedArenaTrace("retrieve bump disabled core=%u request_size=%zu alignment=%zu",
+                     CoreId, Size, Alignment);
+  }
+
+  if (AllocBase == 0) {
+    unlock();
+    return false;
+  }
+
+  // Keep allocator metadata at the beginning of the arena block.  The kernel
+  // only prefaults the first page of a freed run for intrusive freelist
+  // metadata, so tail placement can fault before ownership sync catches up.
+  const uptr UserBegin = roundUp(AllocBase + HeadersSize, Alignment);
+  if (HeaderPos == 0)
+    HeaderPos = UserBegin - HeadersSize;
+
+  if (UNLIKELY(HeaderPos < AllocBase ||
+               UserBegin + Size > AllocBase + AllocSize)) {
+    unlock();
+    return false;
+  }
+
+  Hdr->TotalRetrievedBytes += AllocSize;
+  Hdr->RetrieveCount++;
+  /*
+   * Bump allocations must stay demand-faulted per DESIGN.md.  Ownership is
+   * still published before the LargeBlock header is touched, but the kernel
+   * should not prefault the whole fresh run.  Free-list metadata prefaulting is
+   * handled by the FREE delta path instead.
+   */
+  const u16 LogFlags = 0;
+  if (UNLIKELY(!appendLogLocked(SharedArenaLogOp::Alloc, AllocBase,
+                                AllocSize, LogFlags))) {
+    if (FromBump) {
+      Hdr->BumpOffsetInPages -= NeededPages;
+    } else if (AllocBase != 0) {
+      publishFreeBlockLocked(addrToPageOff(AllocBase),
+                             static_cast<u32>(AllocSize / PageSize),
+                             Zeroed ? AllocBase : 0,
+                             Zeroed ? AllocBase + AllocSize : 0);
+    }
+    Hdr->TotalRetrievedBytes -= AllocSize;
+    Hdr->RetrieveCount--;
+    unlock();
+    sharedArenaTrace(
+        "log append failed on alloc core=%u base=0x%zx size=%zu", CoreId,
+        AllocBase, AllocSize);
+    return false;
+  }
+
+  unlock();
+  OutZeroed = Zeroed;
+
+  if (UNLIKELY(sharedArenaYieldAfterAllocLogEnabled())) {
+    const u32 YieldCount = sharedArenaYieldAfterAllocLogCount();
+    for (u32 I = 0; I < YieldCount; ++I)
+      sched_yield();
+    sharedArenaTrace("retrieve yield-after-log core=%u count=%u commit_base=0x%zx commit_size=%zu",
+                     CoreId, YieldCount, AllocBase, AllocSize);
+  }
+  const u32 SleepUs = sharedArenaSleepAfterAllocLogUs();
+  if (UNLIKELY(SleepUs != 0)) {
+    timespec Ts;
+    Ts.tv_sec = SleepUs / 1000000u;
+    Ts.tv_nsec = static_cast<long>(SleepUs % 1000000u) * 1000L;
+    nanosleep(&Ts, nullptr);
+    sharedArenaTrace("retrieve sleep-after-log core=%u us=%u commit_base=0x%zx commit_size=%zu",
+                     CoreId, SleepUs, AllocBase, AllocSize);
+  }
+
+  sharedArenaTrace("retrieve core=%u request_size=%zu alignment=%zu commit_base=0x%zx commit_size=%zu header_pos=0x%zx",
+                   CoreId, Size, Alignment, AllocBase, AllocSize, HeaderPos);
+
+  OutCommitBase     = AllocBase;
+  OutCommitSize     = AllocSize;
+  OutEntryHeaderPos = HeaderPos;
+  sharedArenaMaybeDumpAllocStats("shared_arena_retrieve");
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// SharedArena::getStats
+// ---------------------------------------------------------------------------
+
+void SharedArena::getStats(uptr &OutFreeCount, uptr &OutDonatedBytes,
+                            uptr &OutRetrievedBytes) const {
+  if (!Initialized) {
+    OutFreeCount = OutDonatedBytes = OutRetrievedBytes = 0;
+    return;
+  }
+  OutFreeCount      = Hdr->FreeCount;
+  OutDonatedBytes   = Hdr->TotalDonatedBytes;
+  OutRetrievedBytes = Hdr->TotalRetrievedBytes;
+}
+
+void SharedArena::getDebugStats(SharedArenaDebugStats &Out) const {
+  Out = {};
+  Out.CoreId = CoreId;
+  if (!Initialized || Hdr == nullptr)
+    return;
+
+  const uptr PageSize = getPageSizeCached();
+  Out.Initialized = 1;
+  Out.TotalDataPages = Hdr->TotalDataPages;
+  Out.BumpOffsetInPages = Hdr->BumpOffsetInPages;
+  Out.FreeListHeadPageOff = Hdr->FreeListHeadPageOff;
+  Out.FreeCount = Hdr->FreeCount;
+  Out.TotalDonatedBytes = Hdr->TotalDonatedBytes;
+  Out.TotalRetrievedBytes = Hdr->TotalRetrievedBytes;
+  Out.DonateCount = Hdr->DonateCount;
+  Out.RetrieveCount = Hdr->RetrieveCount;
+  const u32 RemoteHead =
+      atomic_load(&Hdr->RemoteFreeHead, memory_order_acquire);
+  const u32 RemoteTail =
+      atomic_load(&Hdr->RemoteFreeTail, memory_order_acquire);
+  Out.RemoteFreePending = RemoteTail - RemoteHead;
+  Out.RemoteFreeDropped = Hdr->RemoteFreeDropped;
+  Out.RemoteFreeEnqueueCount = Hdr->RemoteFreeEnqueueCount;
+  Out.RemoteFreeDrainCount = Hdr->RemoteFreeDrainCount;
+
+  if (LogRing != nullptr) {
+    Out.LogHead = atomic_load(&LogRing->Head, memory_order_acquire);
+    Out.LogTail = atomic_load(&LogRing->Tail, memory_order_acquire);
+    Out.LogDropped = atomic_load(&LogRing->Dropped, memory_order_acquire);
+  }
+
+  const u32 MaxWalk = Hdr->TotalDataPages + 1;
+  for (u32 Class = 0; Class < kSharedArenaNumSizeClasses; ++Class) {
+    for (u32 Kind = 0; Kind < 2; ++Kind) {
+      const bool Zeroed = Kind != 0;
+      const SharedArenaBin &Bin =
+          Zeroed ? Hdr->ZeroedBins[Class] : Hdr->DirtyBins[Class];
+      u32 Cur = Bin.HeadPageOff;
+      u32 Walked = 0;
+      while (Cur != kFreeListEnd && Walked < MaxWalk) {
+        FreeBlockHeader *Blk = getFreeBlock(Cur);
+        if (Blk->Magic != kFreeBlockMagic) {
+          Out.FreeListBadMagic++;
+          break;
+        }
+        const uptr Bytes = static_cast<uptr>(Blk->SizeInPages) * PageSize;
+        Out.FreeListBytes += Bytes;
+        if (Zeroed) {
+          Out.ZeroedBinCount++;
+          Out.ZeroedBinBytes += Bytes;
+        } else {
+          Out.DirtyBinCount++;
+          Out.DirtyBinBytes += Bytes;
+        }
+        Out.FreeListWalkCount++;
+        Walked++;
+        Cur = Blk->BinNextPageOff;
+      }
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// SharedArenaPool::getOwningArena（DESIGN.md §2.4 跨核迁移释放路径）
+//
+// 根据块的绝对 VA 计算其归属的 Arena（即最初分配该 VA 的核心）。
+// 用于 deallocate()：将释放的块存入归属 Arena 的空闲列表，而非
+// 当前执行核心的 Arena，确保每个 Arena 仅包含自身 VA 范围内的块。
+// ---------------------------------------------------------------------------
+
+SharedArena *SharedArenaPool::getOwningArena(uptr Va) {
+  if (!Initialized || !isArenaAddr(Va))
+    return nullptr;
+  const u32 Core = static_cast<u32>(
+      (Va - kSharedArenaBaseAddr) / kArenaCapacityPerCore);
+  if (Core >= NumCores)
+    return nullptr;
+  SharedArena *A = &Arenas[Core];
+  return A->isInitialized() ? A : nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// 内存压力水位线检测（DESIGN.md §2.1）
+//
+// 通过读取 /proc/meminfo 获取 MemTotal 和 MemAvailable，计算系统内存
+// 使用率。当使用率超过 kMemoryPressureThresholdPercent 时，判定为
+// 高内存压力，激活 Arena 分配路径。
+//
+// 使用 open/read/close 而非 fopen 以避免在分配器内部触发 malloc 重入。
+// ---------------------------------------------------------------------------
+
+static uptr parseProcMemInfoValue(const char *Buf, const char *FieldName) {
+  const size_t FieldLen = strlen(FieldName);
+  const char *P = Buf;
+  while ((P = strstr(P, FieldName)) != nullptr) {
+    if (P == Buf || *(P - 1) == '\n') {
+      P += FieldLen;
+      while (*P == ':' || *P == ' ' || *P == '\t')
+        P++;
+      uptr Value = 0;
+      while (*P >= '0' && *P <= '9') {
+        Value = Value * 10 + static_cast<uptr>(*P - '0');
+        P++;
+      }
+      return Value; // kB
+    }
+    P++;
+  }
+  return 0;
+}
+
+static u32 sharedArenaEnvU32(const char *Name, u32 Fallback) {
+  const char *Value = getenv(Name);
+  if (Value == nullptr || Value[0] == '\0')
+    return Fallback;
+
+  char *End = nullptr;
+  unsigned long Parsed = strtoul(Value, &End, 10);
+  if (End == Value || *End != '\0' || Parsed > UINT32_MAX)
+    return Fallback;
+  return static_cast<u32>(Parsed);
+}
+
+bool SharedArenaPool::checkMemoryPressure() {
+  int Fd = open("/proc/meminfo", O_RDONLY);
+  if (Fd < 0)
+    return false;
+
+  char Buf[2048];
+  ssize_t N = read(Fd, Buf, sizeof(Buf) - 1);
+  close(Fd);
+  if (N <= 0)
+    return false;
+  Buf[N] = '\0';
+
+  const uptr MemTotalKB = parseProcMemInfoValue(Buf, "MemTotal");
+  const uptr MemAvailableKB = parseProcMemInfoValue(Buf, "MemAvailable");
+
+  if (MemTotalKB == 0)
+    return false;
+
+  const uptr UsagePercent =
+      (MemTotalKB - MemAvailableKB) * 100 / MemTotalKB;
+  const u32 ThresholdPercent =
+      sharedArenaEnvU32("SCUDO_SHARED_ARENA_PRESSURE_THRESHOLD",
+                        kMemoryPressureThresholdPercent);
+  const bool Active = UsagePercent >= ThresholdPercent;
+  sharedArenaTrace("pressure mem_total_kb=%zu mem_available_kb=%zu usage=%zu threshold=%u active=%u",
+                   MemTotalKB, MemAvailableKB, UsagePercent,
+                   ThresholdPercent, Active ? 1u : 0u);
+  return Active;
+}
+
+bool SharedArenaPool::shouldUseArena() {
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+  SharedArenaProfileScope Profile(ProfileShouldUseArena);
+#endif
+
+  if (!Initialized)
+    return false;
+
+  if (UNLIKELY(OwnerPid != static_cast<uptr>(getpid()))) {
+    init();
+    if (!Initialized)
+      return false;
+  }
+
+  if (sharedArenaForceDisabledForTesting()) {
+    atomic_store(&ArenaActive, 1u, memory_order_relaxed);
+    return false;
+  }
+
+  if (sharedArenaForceEnabled()) {
+    static const bool Logged = []() {
+      sharedArenaTrace("forcing shared arena path for testing");
+      return true;
+    }();
+    (void)Logged;
+    atomic_store(&ArenaActive, 2u, memory_order_relaxed);
+    return true;
+  }
+
+  const u32 Count =
+      atomic_fetch_add(&AllocCounter, 1u, memory_order_relaxed);
+  const u32 CheckInterval =
+      sharedArenaEnvU32("SCUDO_SHARED_ARENA_PRESSURE_CHECK_INTERVAL",
+                        kPressureCheckInterval);
+  if (CheckInterval == 0 || (Count % CheckInterval) == 0)
+    atomic_store(&ArenaActive, checkMemoryPressure() ? 2u : 1u,
+                 memory_order_relaxed);
+
+  return atomic_load(&ArenaActive, memory_order_relaxed) == 2u;
+}
+
+void SharedArenaPool::maybeRefreshArenaStateOnCacheHit() {
+  static thread_local u32 CacheHits = 0;
+  // Keep the existing pressure interval for slow checks; only one in 64
+  // cache hits enters shouldUseArena() and its process-wide counter.
+  if ((++CacheHits & 63u) == 0)
+    (void)shouldUseArena();
+}
+
+__attribute__((constructor)) static void sharedArenaEagerInitFromEnv() {
+  if (!sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_EAGER_INIT"))
+    return;
+  SharedArenaPool::getInstance().init();
+  sharedArenaTrace("eager init constructor ready=%u",
+                   SharedArenaPool::getInstance().isReady() ? 1u : 0u);
+}
+
+// ---------------------------------------------------------------------------
+// SharedArenaPool::init
+// ---------------------------------------------------------------------------
+
+// 外层调用保证了该init函数只会被一个线程调用，不需要做线程安全分析
+// 每个进程都会有唯一一个线程调用该函数，创建shared fd
+void SharedArenaPool::init() NO_THREAD_SAFETY_ANALYSIS{
+  const uptr CurrentPid = static_cast<uptr>(getpid());
+
+  if (sharedArenaDisabled()) {
+    invalidateArenaState();
+    atomic_store(&SharedArenaLastInitStage, 1u, memory_order_relaxed);
+    Initialized = false;
+    OwnerPid = CurrentPid;
+    NumCores = 0;
+    return;
+  }
+
+  if (Initialized && OwnerPid == CurrentPid) {
+    atomic_store(&SharedArenaLastInitStage, 2u, memory_order_relaxed);
+    return;
+  }
+
+  if (Initialized && OwnerPid != CurrentPid) {
+    invalidateArenaState();
+    atomic_store(&SharedArenaLastInitStage, 3u, memory_order_relaxed);
+    bool allOk = true;
+
+    for (u32 I = 0; I < NumCores; I++) {
+      if (Arenas[I].isInitialized() &&
+          !Arenas[I].refreshLogRingForCurrentProcess())
+        allOk = false;
+    }
+    Initialized = allOk;
+    if (allOk)
+      OwnerPid = CurrentPid;
+    sharedArenaTrace("pool refreshed after fork ready=%d pid=%zu",
+                     allOk ? 1 : 0, CurrentPid);
+    return;
+  }
+
+  NumCores = getNumberOfCPUs();
+  if (NumCores == 0)
+    NumCores = 1;
+  if (NumCores > kArenaMaxCores)
+    NumCores = kArenaMaxCores;
+
+#if SCUDO_ANDROID
+  SharedArenaInitMode = SharedArenaAndroidInitMode::Unknown;
+  if (!sharedArenaSelectAndroidInitMode()) {
+    atomic_store(&SharedArenaLastInitStage, 4u, memory_order_relaxed);
+    sharedArenaTrace("pool init failed: android system broker unavailable");
+    Initialized = false;
+    return;
+  }
+  sharedArenaTrace("pool init android mode=%u num_cores=%u",
+                   static_cast<unsigned>(SharedArenaInitMode), NumCores);
+#else
+  // Linux: 清理上一次进程会话遗留的具名共享内存。
+  // /dev/shm (tmpfs) 上的文件在进程退出后仍然存在，其中的元数据
+  //（freelist head、entries 等）对应旧进程的状态，直接复用会导致崩溃。
+  if (!sharedArenaAttachEnabled()) {
+    for (u32 I = 0; I < NumCores; I++) {
+      char ShmName[64];
+      snprintf(ShmName, sizeof(ShmName), "/scudo_arena_%u", I);
+      shm_unlink(ShmName);
+    }
+  }
+#endif
+
+  // 为每个 CPU 核心初始化一个 Arena。
+  // 若某个 Arena 初始化失败，则 Pool 的 Initialized 也标记为 false, 走原来的MemAllocaCache路径。
+  atomic_store(&SharedArenaLastInitStage, 5u, memory_order_relaxed);
+  bool allOk = true;
+  u32 OkMask = 0;
+  u32 FailMask = 0;
+  u32 LastErrno = 0;
+  for (u32 I = 0; I < NumCores; I++) {
+    errno = 0;
+    if (Arenas[I].init(I)) {
+      OkMask |= 1u << I;
+    } else {
+      allOk = false;
+      FailMask |= 1u << I;
+      LastErrno = static_cast<u32>(errno);
+    }
+  }
+  atomic_store(&SharedArenaLastInitOkMask, OkMask, memory_order_relaxed);
+  atomic_store(&SharedArenaLastInitFailMask, FailMask, memory_order_relaxed);
+  atomic_store(&SharedArenaLastInitErrno, LastErrno, memory_order_relaxed);
+  if (allOk && sharedArenaResetOnInitEnabled()) {
+    sharedArenaTrace("pool init: resetting shared arena state by env");
+    for (u32 I = 0; I < NumCores; I++) {
+      if (Arenas[I].isInitialized())
+        Arenas[I].reset();
+    }
+  }
+#if SCUDO_ANDROID
+  if (!allOk)
+    SharedArenaInitMode = SharedArenaAndroidInitMode::Unknown;
+#endif
+  sharedArenaTrace("pool init finished ready=%d", allOk ? 1 : 0);
+  invalidateArenaState();
+  Initialized = allOk;
+  atomic_store(&SharedArenaLastInitStage, allOk ? 6u : 7u,
+               memory_order_relaxed);
+  if (allOk)
+    OwnerPid = CurrentPid;
+}
+
+extern "C" int __scudo_shared_arena_debug_status(char *Buf, size_t BufSize) {
+  if (Buf == nullptr || BufSize == 0)
+    return -1;
+  SharedArenaPool &Pool = SharedArenaPool::getInstance();
+  const u32 OkMask = atomic_load(&SharedArenaLastInitOkMask, memory_order_relaxed);
+  const u32 FailMask =
+      atomic_load(&SharedArenaLastInitFailMask, memory_order_relaxed);
+  const u32 LastErrno =
+      atomic_load(&SharedArenaLastInitErrno, memory_order_relaxed);
+  const u32 Stage = atomic_load(&SharedArenaLastInitStage, memory_order_relaxed);
+  const int Written =
+      snprintf(Buf, BufSize,
+               "shared-arena ready=%u cores=%u stage=%u ok_mask=0x%x fail_mask=0x%x errno=%u",
+               Pool.isReady() ? 1u : 0u, Pool.getNumCores(), Stage,
+               OkMask, FailMask, LastErrno);
+  return Written < 0 ? -1 : Written;
+}
+
+void SharedArenaPool::reset() {
+  if (!Initialized)
+    return;
+  for (u32 I = 0; I < NumCores; ++I) {
+    if (Arenas[I].isInitialized())
+      Arenas[I].reset();
+  }
+}
