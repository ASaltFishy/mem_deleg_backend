+static const char *sizeUnit(uptr Size, double &Value) {
+  if (Size >= (1UL << 20)) {
+    Value = static_cast<double>(Size) / static_cast<double>(1UL << 20);
+    return "MiB";
+  }
+  if (Size >= (1UL << 10)) {
+    Value = static_cast<double>(Size) / static_cast<double>(1UL << 10);
+    return "KiB";
+  }
+  Value = static_cast<double>(Size);
+  return "B";
+}
