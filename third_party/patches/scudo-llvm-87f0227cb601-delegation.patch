+  EXPECT_EQ(reinterpret_cast<scudo::uptr>(Reused), Va);
+
+  scudo::SharedArenaDebugStats AfterReuse;
+  OwnerArena->getDebugStats(AfterReuse);
+  EXPECT_EQ(AfterReuse.RemoteFreeDrainCount, Before.RemoteFreeDrainCount);
+
+  Allocator->deallocate(Options, Reused);
+}
