+static const char *getSelfExePath() {
+#if SCUDO_LINUX
+  static char Buf[PATH_MAX];
+  const ssize_t N = readlink("/proc/self/exe", Buf, sizeof(Buf) - 1);
+  if (N <= 0)
+    return nullptr;
+  Buf[N] = '\0';
+  return Buf;
+#else
+  return nullptr;
+#endif
+}
