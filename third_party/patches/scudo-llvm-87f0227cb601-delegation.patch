+// ---------------------------------------------------------------------------
+// 内存压力水位线（DESIGN.md §2.1）
+// ---------------------------------------------------------------------------
+
+static constexpr u32 kMemoryPressureThresholdPercent = 80;
+static constexpr u32 kPressureCheckInterval = 64;
+
+// ---------------------------------------------------------------------------
+// FreeBlockHeader：侵入式空闲块头部（DESIGN.md §2.2）
+//
+// 写在每个空闲块的起始地址处。被释放的块已拥有物理页，写入不会触发额外
+// page fault。使用相对于 Arena 数据区起始（DataBase = BaseAddr +
+// kArenaHeaderSize）的页偏移，而非绝对 VA，节省空间并天然兼容 32/64 位。
+// ---------------------------------------------------------------------------
+struct FreeBlockHeader {
+  u32 PrevPageOff;   // 前驱空闲块的页偏移（kFreeListEnd = 链表头）
+  u32 NextPageOff;   // 后继空闲块的页偏移（kFreeListEnd = 链表尾）
+  u32 SizeInPages;   // 本空闲块的页数
+  u32 Magic;         // == kFreeBlockMagic 时为有效空闲块
+  u32 BinPrevPageOff;
+  u32 BinNextPageOff;
+  u32 Flags;         // 额外状态位（如该块内容是否可视为零页）
+  uptr ZeroStart;    // 已知清零区间起点（绝对 VA，半开区间）
+  uptr ZeroEnd;      // 已知清零区间终点（绝对 VA，半开区间）
+};
+
+static constexpr u32 kFreeBlockFlagZeroed = 1U << 0;
+static constexpr u32 kFreeBlockFlagRemotePending = 1U << 1;
+
+struct SharedArenaBin {
+  u32 HeadPageOff;
+  u32 Count;
+};
+
+struct SharedArenaRemoteFreeDesc {
+  atomic_u32 Seq;
+  u32 PageOff;
+  u32 Pages;
+  u32 Flags;
+  uptr ZeroStart;
+  uptr ZeroEnd;
+};
+
+// ---------------------------------------------------------------------------
+// SharedArenaHeader：每个 Arena 共享内存前 kArenaHeaderSize 字节内的元数据
+//
+// 该结构体存放于共享内存，所有映射该 Arena 的进程均可见并可修改。
+// 跨进程锁通过用户态 spinlock 实现。Arena 绑定 per-core，竞争预期很小，
+// 热路径不进入内核。
+//
+// 内存管理采用 Bump 指针 + size-class 侵入式空闲链表混合方案：
+//  - BumpOffsetInPages：单调递增，首次分配时推进，页面通过 page fault
+//    按需提交，零系统调用、零元数据写入。
+//  - DirtyBins / ZeroedBins：按页数分桶，块内写入侵入式链表字段，
+//    free 路径默认不清零，ZeroFill 分配按需清用户范围。
+//  - RemoteFrees：跨核 free 只发布 descriptor；owner arena drain 后才
+//    写正式 FreeBlockHeader 并接入 bin，避免跨核写可见 freelist 字段。
+// ---------------------------------------------------------------------------
+struct alignas(64) SharedArenaHeader {
+  atomic_u32 Lock;
+  atomic_u32 Version;
+
+  // Bump 指针：当前已推进到的页偏移（相对 DataBase，单位：页）。
+  // 初始值 0，表示整个数据区尚未分配。
+  u32 BumpOffsetInPages;
+
+  // 数据区总页数（= (kArenaCapacityPerCore - kArenaHeaderSize) / PageSize）。
+  u32 TotalDataPages;
+
+  // 旧内核 mm_release 兼容链表头：按 VA 递增的全局 freelist。
+  u32 FreeListHeadPageOff;
+
+  // 当前全局 freelist 中已发布的空闲块数量；bin 只做快速索引。
+  u32 FreeCount;
+
+  // 统计信息（best effort，无需强一致）。
+  uptr TotalDonatedBytes;
+  uptr TotalRetrievedBytes;
+  u32  DonateCount;
+  u32  RetrieveCount;
+
+  SharedArenaBin DirtyBins[kSharedArenaNumSizeClasses];
+  SharedArenaBin ZeroedBins[kSharedArenaNumSizeClasses];
+
+  atomic_u32 RemoteFreeHead;
+  atomic_u32 RemoteFreeTail;
+  u32 RemoteFreeDropped;
+  u32 RemoteFreeEnqueueCount;
+  u32 RemoteFreeDrainCount;
+
+  SharedArenaRemoteFreeDesc RemoteFrees[kSharedArenaRemoteFreeCapacity];
+};
+
+static_assert(sizeof(SharedArenaHeader) <= kArenaHeaderSize,
+              "SharedArenaHeader 超过了 kArenaHeaderSize，请扩大头部区域");
+
