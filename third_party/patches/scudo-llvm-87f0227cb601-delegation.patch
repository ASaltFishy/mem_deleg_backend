+struct CrossCoreFreeContext {
+  LargeAllocator *Alloc = nullptr;
+  Options *Opt = nullptr;
+  int FreeCpu = -1;
+  u64 Iterations = 0;
+  u32 BatchSize = 1;
+  bool TouchPages = false;
+  uptr Size = 0;
+  pthread_mutex_t Mutex = PTHREAD_MUTEX_INITIALIZER;
+  pthread_cond_t Cond = PTHREAD_COND_INITIALIZER;
+  std::vector<void *> Ptrs;
+  std::vector<uint64_t> FreeSamples;
+  bool Ready = false;
+  bool Done = false;
+  bool Stop = false;
+  int Err = 0;
+};
+
+static void *crossCoreFreeThread(void *Arg) {
+  auto *Ctx = reinterpret_cast<CrossCoreFreeContext *>(Arg);
+  if (Ctx->FreeCpu >= 0 && !pinSelfToCpu(Ctx->FreeCpu)) {
+    Ctx->Err = errno;
+    return nullptr;
+  }
+
+  for (;;) {
+    pthread_mutex_lock(&Ctx->Mutex);
+    while (!Ctx->Ready && !Ctx->Stop)
+      pthread_cond_wait(&Ctx->Cond, &Ctx->Mutex);
+    if (Ctx->Stop) {
+      pthread_mutex_unlock(&Ctx->Mutex);
+      return nullptr;
+    }
+    std::vector<void *> Local;
+    Local.swap(Ctx->Ptrs);
+    Ctx->Ready = false;
+    pthread_mutex_unlock(&Ctx->Mutex);
+
+    for (void *P : Local) {
+      const uint64_t T0 = nowNs();
+      Ctx->Alloc->deallocate(*Ctx->Opt, P);
+      const uint64_t T1 = nowNs();
+      Ctx->FreeSamples.push_back(T1 - T0);
+    }
+
+    pthread_mutex_lock(&Ctx->Mutex);
+    Ctx->Done = true;
+    pthread_cond_signal(&Ctx->Cond);
+    pthread_mutex_unlock(&Ctx->Mutex);
+  }
+}
+
+static bool runCrossCoreFreeBench(LargeAllocator &Alloc, Options &Opt,
+                                  SharedArenaPool &Pool, uptr Size,
+                                  u64 Iterations, u32 Warmup, u32 BatchSize,
+                                  int AllocCpu, int FreeCpu, bool TouchPages) {
+  setSharedArenaForceForTesting(true);
+  if (AllocCpu >= 0 && !pinSelfToCpu(AllocCpu)) {
+    fprintf(stderr, "cross_core_free: pin alloc cpu %d failed errno=%d\n",
+            AllocCpu, errno);
+    return false;
+  }
+
+  CrossCoreFreeContext Ctx;
+  Ctx.Alloc = &Alloc;
+  Ctx.Opt = &Opt;
+  Ctx.FreeCpu = FreeCpu;
+  Ctx.Iterations = Iterations;
+  Ctx.BatchSize = BatchSize;
+  Ctx.TouchPages = TouchPages;
+  Ctx.Size = Size;
+  Ctx.Ptrs.reserve(BatchSize);
+  Ctx.FreeSamples.reserve(static_cast<size_t>(Iterations) * BatchSize);
+
+  pthread_t Thread;
+  if (pthread_create(&Thread, nullptr, crossCoreFreeThread, &Ctx) != 0) {
+    fprintf(stderr, "cross_core_free: pthread_create failed errno=%d\n", errno);
+    return false;
+  }
+
+  const uptr PageSize = getPageSizeCached();
+  std::vector<uint64_t> AllocSamples;
+  std::vector<uint64_t> HandoffSamples;
+  AllocSamples.reserve(static_cast<size_t>(Iterations) * BatchSize);
+  HandoffSamples.reserve(Iterations);
+
+  auto runBatch = [&](bool Measure, u64 Iter) -> bool {
+    std::vector<void *> Batch;
+    Batch.reserve(BatchSize);
+    for (u32 I = 0; I < BatchSize; ++I) {
+      const uint64_t T0 = nowNs();
+      void *P = Alloc.allocate(Opt, Size);
+      const uint64_t T1 = nowNs();
+      if (!P) {
+        fprintf(stderr, "cross_core_free: alloc failed iter=%" PRIu64 " item=%u\n",
+                Iter, I);
+        return false;
+      }
+      if (TouchPages)
+        touchAllocatedPages(P, Size, PageSize, 0x5a);
+      if (Measure)
+        AllocSamples.push_back(T1 - T0);
+      Batch.push_back(P);
+    }
+
+    const uint64_t H0 = nowNs();
+    pthread_mutex_lock(&Ctx.Mutex);
+    Ctx.Ptrs.swap(Batch);
+    Ctx.Done = false;
+    Ctx.Ready = true;
+    pthread_cond_signal(&Ctx.Cond);
+    while (!Ctx.Done)
+      pthread_cond_wait(&Ctx.Cond, &Ctx.Mutex);
+    pthread_mutex_unlock(&Ctx.Mutex);
+    if (Measure)
+      HandoffSamples.push_back(nowNs() - H0);
+    return true;
+  };
+
+  for (u32 I = 0; I < Warmup; ++I) {
+    if (!runBatch(false, I))
+      break;
+  }
+  waitSharedArenaLogDrain("cross_core_free_warmup", true);
+  printArenaDebugStats("before_cross_core_free", Pool);
+
+  bool Ok = true;
+  for (u64 I = 0; I < Iterations; ++I) {
+    if (!runBatch(true, I)) {
+      Ok = false;
+      break;
+    }
+  }
+  waitSharedArenaLogDrain("cross_core_free", true);
+  printArenaDebugStats("after_cross_core_free", Pool);
+
+  pthread_mutex_lock(&Ctx.Mutex);
+  Ctx.Stop = true;
+  pthread_cond_signal(&Ctx.Cond);
+  pthread_mutex_unlock(&Ctx.Mutex);
+  pthread_join(Thread, nullptr);
+
+  if (Ctx.Err != 0) {
+    fprintf(stderr, "cross_core_free: free thread setup failed errno=%d\n",
+            Ctx.Err);
+    Ok = false;
+  }
+
+  SampleStats AllocStats;
+  SampleStats FreeStats;
+  SampleStats HandoffStats;
+  computeStats(AllocSamples, AllocStats);
+  computeStats(Ctx.FreeSamples, FreeStats);
+  computeStats(HandoffSamples, HandoffStats);
+  printf("-- cross-core-free delegated alloc_cpu=%d free_cpu=%d batch=%u --\n",
+         AllocCpu, FreeCpu, BatchSize);
+  printStats("  alloc_only", AllocStats);
+  printStats("  free_only", FreeStats);
+  printStats("  batch_handoff", HandoffStats);
+  return Ok;
+}
