+void sharedArenaTrace(const char *Format, ...) {
+  if (!sharedArenaTraceEnabled())
+    return;
+
+  auto TraceLimit = []() -> u32 {
+    const char *Value = getenv("SCUDO_SHARED_ARENA_TRACE_LIMIT");
+    if (Value == nullptr || Value[0] == '\0')
+      return 64;
+    char *End = nullptr;
+    unsigned long Parsed = strtoul(Value, &End, 10);
+    if (End == Value || *End != '\0' || Parsed > UINT32_MAX)
+      return 64;
+    return static_cast<u32>(Parsed);
+  };
+
+  const u32 Count =
+      atomic_fetch_add(&SharedArenaTraceCount, 1u, memory_order_relaxed);
+  const u32 Limit = TraceLimit();
+  if (Count >= Limit) {
+    if (Count == Limit) {
+      static constexpr char LimitMsg[] =
+          "[scudo][shared_arena] trace limit reached, suppressing further logs\n";
+      ssize_t R = write(STDERR_FILENO, LimitMsg, sizeof(LimitMsg) - 1);
+      (void)R;
+    }
+    return;
+  }
+
+  char Buffer[512];
+  int PrefixLen =
+      snprintf(Buffer, sizeof(Buffer), "[scudo][shared_arena] ");
+  if (PrefixLen < 0 || static_cast<size_t>(PrefixLen) >= sizeof(Buffer))
+    return;
+
+  va_list Args;
+  va_start(Args, Format);
+  int BodyLen = vsnprintf(Buffer + PrefixLen,
+                          sizeof(Buffer) - static_cast<size_t>(PrefixLen),
+                          Format, Args);
+  va_end(Args);
+  if (BodyLen < 0)
+    return;
+
+  size_t TotalLen =
+      Min(sizeof(Buffer) - 1, static_cast<size_t>(PrefixLen + BodyLen));
+  if (TotalLen == 0 || Buffer[TotalLen - 1] != '\n')
+    Buffer[TotalLen++] = '\n';
+
+  const char *TraceFile = getenv("SCUDO_SHARED_ARENA_TRACE_FILE");
+  if (TraceFile != nullptr && TraceFile[0] != '\0') {
+    int Fd = open(TraceFile, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+    if (Fd >= 0) {
+      ssize_t R = write(Fd, Buffer, TotalLen);
+      (void)R;
+      close(Fd);
+    }
+  }
+
+  outputRaw(Buffer);
+}
+
+static u64 sharedArenaStatsInterval() {
+  const char *Value = getenv("SCUDO_ALLOC_STATS_INTERVAL");
+  if (Value == nullptr || Value[0] == '\0')
+    return 128;
+  u64 Parsed = 0;
+  bool SawDigit = false;
+  for (const char *P = Value; *P >= '0' && *P <= '9'; ++P) {
+    SawDigit = true;
+    const u64 Digit = static_cast<u64>(*P - '0');
+    if (Parsed > (UINT64_MAX - Digit) / 10)
+      return 128;
+    Parsed = Parsed * 10 + Digit;
+  }
+  return SawDigit && Parsed != 0 ? Parsed : 128;
+}
+
+static void sharedArenaMaybeDumpAllocStats(const char *Reason) {
+  if (!sharedArenaEnvEnabled("SCUDO_ALLOC_STATS"))
+    return;
+  const u64 Interval = sharedArenaStatsInterval();
+  const u64 Count = atomic_fetch_add(&SharedArenaAllocStatsCount, 1,
+                                     memory_order_relaxed) + 1;
+  if (Count % Interval != 0)
+    return;
+
+  SharedArenaPoolDebugStats S = {};
+  SharedArenaPool::getInstance().getDebugStats(S);
+
+  char Buffer[1024];
+  const int Len = snprintf(
+      Buffer, sizeof(Buffer),
+      "SCUDO_ALLOC_STATS pid=%d seq=%llu reason=%s "
+      "shared_arena_ready=%u shared_arena_arenas=%u "
+      "shared_arena_in_use_bytes=%zu shared_arena_bump_bytes=%zu "
+      "shared_arena_free_list_bytes=%zu "
+      "shared_arena_total_retrieved_bytes=%zu "
+      "shared_arena_total_donated_bytes=%zu "
+      "shared_arena_retrieve_count=%u shared_arena_donate_count=%u "
+      "shared_arena_log_dropped=%u "
+      "shared_arena_active_drain_calls=%llu "
+      "shared_arena_active_drain_success=%llu "
+      "shared_arena_active_drain_failed=%llu "
+      "shared_arena_active_drain_ns=%llu\n",
+      static_cast<int>(getpid()), static_cast<unsigned long long>(Count),
+      Reason, S.Initialized, S.InitializedArenas, S.InUseBytes, S.BumpBytes,
+      S.FreeListBytes, S.TotalRetrievedBytes, S.TotalDonatedBytes,
+      S.RetrieveCount, S.DonateCount, S.LogDropped,
+      static_cast<unsigned long long>(S.ActiveDrainCalls),
+      static_cast<unsigned long long>(S.ActiveDrainSuccess),
+      static_cast<unsigned long long>(S.ActiveDrainFailed),
+      static_cast<unsigned long long>(S.ActiveDrainNs));
+  if (Len <= 0)
+    return;
+
+  const char *Path = getenv("SCUDO_ALLOC_STATS_FILE");
+  if (Path == nullptr || Path[0] == '\0')
+    Path = "/data/local/tmp/scudo_alloc_stats.log";
+  const int Fd = open(Path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0666);
+  if (Fd < 0)
+    return;
+  write(Fd, Buffer, static_cast<size_t>(Len) < sizeof(Buffer)
+                       ? static_cast<size_t>(Len)
+                       : sizeof(Buffer) - 1);
+  close(Fd);
+}
