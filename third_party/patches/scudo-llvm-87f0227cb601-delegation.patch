+  u32 LogDropped = 0;
+  u64 ActiveDrainCalls = 0;
+  u64 ActiveDrainSuccess = 0;
+  u64 ActiveDrainFailed = 0;
+  u64 ActiveDrainNs = 0;
+  u64 ArenaAllocAttempts = 0;
+  u64 ArenaAllocSuccess = 0;
+  u64 ArenaAllocFallback = 0;
