+static u32 sharedArenaEnvU32(const char *Name, u32 Fallback);
+
+static void initSharedArenaEnvCacheOnce() {
+  // 0: uninitialized, 1: initializing, 2: initialized
+  u32 Expected = 0u;
+  if (atomic_compare_exchange_strong(&SharedArenaEnvCacheState, &Expected, 1u,
+                                      memory_order_acq_rel)) {
+    // First thread initializes cached values.
+    atomic_store(&SharedArenaEnvAttach, sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_ATTACH")
+                                           ? 1u
+                                           : 0u,
+                memory_order_relaxed);
+    atomic_store(&SharedArenaEnvForce, sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_FORCE")
+                                            ? 1u
+                                            : 0u,
+                memory_order_relaxed);
+    atomic_store(&SharedArenaEnvTrace, sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_TRACE")
+                                            ? 1u
+                                            : 0u,
+                memory_order_relaxed);
+#if SCUDO_SHARED_ARENA_ENABLE_PROFILE
+    atomic_store(&SharedArenaEnvProfile,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_PROFILE") ? 1u : 0u,
+                 memory_order_relaxed);
+#endif
+    atomic_store(&SharedArenaEnvResetOnInit,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_RESET_ON_INIT") ? 1u
+                                                                           : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvDisable,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_DISABLE") ? 1u : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvAllowNoKernel,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_ALLOW_NO_KERNEL")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvDisableFreelist,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_DISABLE_FREELIST")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvDisableFillAlloc,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_DISABLE_FILL_ALLOC")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvYieldAfterAllocLog,
+                 sharedArenaEnvEnabled(
+                     "SCUDO_SHARED_ARENA_YIELD_AFTER_ALLOC_LOG")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvYieldAfterAllocLogCount,
+                 sharedArenaEnvU32(
+                     "SCUDO_SHARED_ARENA_YIELD_AFTER_ALLOC_LOG_COUNT", 1u),
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvEnableRemoteFreeQueue,
+                 sharedArenaEnvEnabled(
+                     "SCUDO_SHARED_ARENA_ENABLE_REMOTE_FREE_QUEUE")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    const bool FreelistSplitEnabled = sharedArenaEnvEnabled(
+        "SCUDO_SHARED_ARENA_ENABLE_FREELIST_SPLIT");
+    const bool FreelistSplitDisabled = sharedArenaEnvEnabled(
+        "SCUDO_SHARED_ARENA_DISABLE_FREELIST_SPLIT");
+    atomic_store(&SharedArenaEnvEnableFreelistSplit,
+                 FreelistSplitEnabled && !FreelistSplitDisabled ? 1u : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvDisableBump,
+                 sharedArenaEnvEnabled("SCUDO_SHARED_ARENA_DISABLE_BUMP")
+                     ? 1u
+                     : 0u,
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvSleepAfterAllocLogUs,
+                 sharedArenaEnvU32("SCUDO_SHARED_ARENA_SLEEP_AFTER_ALLOC_LOG_US",
+                                   0u),
+                 memory_order_relaxed);
+    atomic_store(&SharedArenaEnvCacheState, 2u, memory_order_release);
+    return;
+  }
+
+  // Other threads spin until initialization completes.
+  while (atomic_load(&SharedArenaEnvCacheState, memory_order_acquire) != 2u)
+    ;
+}
